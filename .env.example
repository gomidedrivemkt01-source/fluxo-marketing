# Copie para .env e preencha. O .env fica fora do Git.
DB_SENHA=troque-por-uma-senha-forte
PORTA=8000

APP_ENV=production
APP_NAME=Fluxo Marketing
APP_PUBLIC_URL=http://192.168.0.160:8000
APP_ALLOWED_ORIGINS=["http://192.168.0.160:8000"]
# Rede interna sem HTTPS. Com HTTPS, use APP_COOKIE_SECURE=true e APP_ALLOW_INSECURE_HTTP=false.
APP_COOKIE_SECURE=false
APP_ALLOW_INSECURE_HTTP=true

# Gere cada um com: openssl rand -base64 48   (valores diferentes)
APP_SESSION_SECRET=troque-por-um-segredo-aleatorio-com-32-caracteres-ou-mais
APP_TOKEN_ENCRYPTION_KEY=troque-por-outro-segredo-aleatorio-com-32-caracteres-ou-mais

APP_STORAGE_BUCKET=demand-files
APP_STORAGE_MAX_FILE_SIZE=26214400
APP_STORAGE_SIGNED_URL_TTL=120
APP_BOOTSTRAP_ORGANIZATION_NAME=Marketing
APP_BOOTSTRAP_ADMIN_EMAIL=

BACKUP_HORA=23
BACKUP_DIAS=30
